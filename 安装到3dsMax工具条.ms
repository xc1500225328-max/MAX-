/*
    编码助手工具 - 3ds Max 工具条安装器

    用法：
    1. 在 3ds Max 中执行 Scripting > Run Script，选择本文件。
    2. 重启 3ds Max，或直接到 Customize User Interface 中刷新查看。
    3. 在 Toolbars 页签里选择 Category: 编码助手工具，把 9 个命令拖到任意工具条。
*/

(
    local toolCategory = "编码助手工具"
    local toolFolder = "EncodingAssistantTools"
    local installerPath = getSourceFileName()
    local sourceRoot = getFilenamePath installerPath
    local packageRoot = sourceRoot + "3dsMaxToolbarPackage\\"

    local scripts = #(
        #("CA_ACESConverter", "ACES v14.3", "ACEScg 助手 v14.3：转换、VRayColor 原色与凹凸修复", "ACES转换脚本.ms", "ca_aces_v2"),
        #("CA_LightControl", "灯光", "V-Ray 灯光与 VRay/Corona 自发光控制", "灯光控制.ms", "ca_light_v2"),
        #("CA_EmissionControl", "自发光", "独立自发光强度统一工具", "自发光控制.ms", "ca_light_v2"),

        #("CA_MaterialMerger", "材质合并", "扫描并安全合并重复材质", "材质合并.ms", "ca_material_merge_v1"),
        #("CA_GroupSorter", "组排序", "组模型统计、排序与单对象组清理", "组排序.ms", "ca_group_sort_v1"),
        #("CA_RenderableControl", "渲染", "物体可渲染控制", "物体可渲染控制.ms", "ca_renderable_v2"),
        #("CA_VRayCamManager", "相机", "VRay 相机管理助手", "相机列表VR专用版.ms", "ca_camera_v2"),
        #("CA_TimeJump", "跳帧", "灵感时间控制器", "跳转帧.ms", "ca_timejump_v2"),
        #("CA_BatchAddPrefix", "前缀", "批量添加前缀", "批量添加前缀.ms", "ca_add_prefix_v1")
    )

    fn ensureSlash p =
    (
        if p[p.count] != "\\" then p + "\\" else p
    )

    fn makeDirSafe p =
    (
        local dirClass = dotNetClass "System.IO.Directory"
        if not (dirClass.Exists p) do makeDir p
    )

    fn copyFilesRecursive src dst =
    (
        src = ensureSlash src
        dst = ensureSlash dst
        makeDirSafe dst

        for f in getFiles (src + "*") do
        (
            local outFile = dst + filenameFromPath f
            if doesFileExist outFile do deleteFile outFile
            copyFile f outFile
        )

        for d in getDirectories (src + "*") do
        (
            local folderName = getFilenameFile (trimRight d "\\")
            copyFilesRecursive d (dst + folderName + "\\")
        )
    )

    fn writeLauncherMacro outFile macroName buttonText toolTip sourceFile iconBase =
    (
        local scriptRelPath = "\\\\" + toolFolder + "\\\\" + sourceFile

        format "macroScript %\n" macroName to:outFile
        format "category:\"%\"\n" toolCategory to:outFile
        format "toolTip:\"%\"\n" toolTip to:outFile
        format "buttonText:\"%\"\n" buttonText to:outFile
        format "iconName:\"%/%\"\n" toolFolder iconBase to:outFile
        format "(\n" to:outFile
        format "    local scriptPath = getDir #userScripts + \"%\"\n" scriptRelPath to:outFile
        format "    if doesFileExist scriptPath then\n" to:outFile
        format "    (\n" to:outFile
        format "        fileIn scriptPath\n" to:outFile
        format "    )\n" to:outFile
        format "    else\n" to:outFile
        format "    (\n" to:outFile
        format "        messageBox (\"找不到脚本文件：\\n\" + scriptPath) title:\"%\"\n" toolCategory to:outFile
        format "    )\n" to:outFile
        format ")\n\n" to:outFile
    )

    try
    (
        if installerPath == undefined or installerPath == "" do
        (
            throw "请从文件执行本安装器，不要直接粘贴到 Listener。"
        )

        local userScriptsDir = ensureSlash (getDir #userScripts)
        local userMacrosDir = ensureSlash (getDir #userMacros)
        local userIconsDir = ensureSlash (getDir #userIcons)

        local installScriptDir = userScriptsDir + toolFolder + "\\"
        local iconSrcDir = packageRoot + "icons\\"
        local iconDstDir = userIconsDir

        makeDirSafe installScriptDir

        for item in scripts do
        (
            local src = sourceRoot + item[4]
            local dst = installScriptDir + item[4]
            if doesFileExist src then
            (
                if doesFileExist dst do deleteFile dst
                copyFile src dst
            )
            else
            (
                throw ("缺少源脚本：\n" + src)
            )
        )

        local dirClass = dotNetClass "System.IO.Directory"

        if dirClass.Exists iconSrcDir then
        (
            copyFilesRecursive iconSrcDir iconDstDir
        )
        else
        (
            throw ("缺少图标目录：\n" + iconSrcDir)
        )

        local macroPath = userMacrosDir + toolCategory + "-Macros.mcr"
        local f = createFile macroPath

        format "-- Auto-generated by %\n\n" toolCategory to:f
        for item in scripts do
        (
            writeLauncherMacro f item[1] item[2] item[3] item[4] item[5]
        )
        close f

        fileIn macroPath

        messageBox ("安装完成。\n\n命令分类：" + toolCategory + "\n宏命令文件：\n" + macroPath + "\n\n下一步：Customize > Customize User Interface > Toolbars，选择分类【" + toolCategory + "】，把命令拖到工具条。\n\n如果图标没有立即显示，请重启 3ds Max。") title:toolCategory
    )
    catch
    (
        messageBox ("安装失败：\n" + (getCurrentException())) title:toolCategory
    )
)
